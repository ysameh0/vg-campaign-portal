# Copy to .env.local and fill in from the Supabase project dashboard.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never exposed to the client, never committed.
SUPABASE_SERVICE_ROLE_KEY=

# VG Messaging Dispatcher.
DISPATCHER_BASE_URL=https://dispatcher-production-72fc.up.railway.app
DISPATCHER_API_KEY=

# Secret used to sign the short-lived cookie issued after a correct share
# password, so /share/[id] doesn't need to re-check the password on every
# request. Any long random string.
SHARE_SESSION_SECRET=
